[
  {
    "scenario": "DEFAULT",
    "lines": [
      {"id": "rdl1", "order": 1, "code": "///Initialization"},
      {"id": "rdl2", "order": 2, "code": "// Rate Calculation with Net Metering Support"},
      {"id": "rdl3", "order": 3, "code": "total = 0"},
      {"id": "rdl4", "order": 4, "code": "subtotal = 0"},
      {"id": "rdl5", "order": 5, "code": "nem_export_credit = 0"},
      {"id": "rdl6", "order": 6, "code": "// Determine effective date for factor lookups (supports overrides)"},
      {"id": "rdl7", "order": 7, "code": "effective_date = INPUT.BILL_DATE"},
      {"id": "rdl8", "order": 8, "code": "IF OVERRIDE.BILL_DATE != \"\""},
      {"id": "rdl9", "order": 9, "code": "effective_date = OVERRIDE.BILL_DATE"},
      {"id": "rdl10", "order": 10, "code": "ELSEIF OVERRIDE.BILL_DATE_OFFSET_YEARS != 0"},
      {"id": "rdl11", "order": 11, "code": "effective_date = ADD_YEARS(INPUT.BILL_DATE, OVERRIDE.BILL_DATE_OFFSET_YEARS)"},
      {"id": "rdl12", "order": 12, "code": "ELSEIF OVERRIDE.BILL_DATE_OFFSET_MONTHS != 0"},
      {"id": "rdl13", "order": 13, "code": "effective_date = ADD_MONTHS(INPUT.BILL_DATE, OVERRIDE.BILL_DATE_OFFSET_MONTHS)"},
      {"id": "rdl14", "order": 14, "code": "ENDIF"},
      {"id": "rdl15", "order": 15, "code": "// Extract billing period info using date functions"},
      {"id": "rdl16", "order": 16, "code": "billing_month = EXTRACT_MONTH(INPUT.BILL_DATE)"},
      {"id": "rdl16a", "order": 16.1, "code": "// Summer boundaries come from factors (data-driven), not hardcoded — works for any utility"},
      {"id": "rdl16b", "order": 16.2, "code": "summer_start = GET_FACTOR(\"SEASON\", \"SUMMER_START_MONTH\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl16c", "order": 16.3, "code": "summer_end = GET_FACTOR(\"SEASON\", \"SUMMER_END_MONTH\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl17", "order": 17, "code": "billing_season = GET_SEASON(INPUT.BILL_DATE, summer_start, summer_end)"},
      {"id": "rdl18", "order": 18, "code": "// Convert season to numeric for output (1=summer, 0=winter)"},
      {"id": "rdl19", "order": 19, "code": "is_summer = 0"},
      {"id": "rdl20", "order": 20, "code": "IF billing_season == \"SUMMER\""},
      {"id": "rdl21", "order": 21, "code": "is_summer = 1"},
      {"id": "rdl22", "order": 22, "code": "ENDIF"},
      {"id": "rdl23", "order": 23, "code": "///Customer Charge"},
      {"id": "rdl24", "order": 24, "code": "// Step 1: Customer Charge"},
      {"id": "rdl25", "order": 25, "code": "customer_charge = GET_FACTOR(INPUT.RATE, \"CUSTOMER_CHARGE\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl26", "order": 26, "code": "customer_charge = ROUND(customer_charge, 2)"},
      {"id": "rdl27", "order": 27, "code": "subtotal = subtotal + customer_charge"},
      {"id": "rdl28", "order": 28, "code": "///Energy Charge"},
      {"id": "rdl29", "order": 29, "code": "// Step 2: Energy Charge using CALCULATE_TIERED function"},
      {"id": "rdl30", "order": 30, "code": "tier1_rate = GET_FACTOR(INPUT.RATE, \"ENERGY_CHARGE\", \"0\", \"\", \"\", effective_date)"},
      {"id": "rdl31", "order": 31, "code": "tier2_rate = GET_FACTOR(INPUT.RATE, \"ENERGY_CHARGE\", \"1000\", \"\", \"\", effective_date)"},
      {"id": "rdl32", "order": 32, "code": "tier1_limit = 1000"},
      {"id": "rdl33", "order": 33, "code": "energy_charge = CALCULATE_TIERED(INPUT.KWH, tier1_limit, tier1_rate, tier2_rate)"},
      {"id": "rdl34", "order": 34, "code": "energy_charge = ROUND(energy_charge, 2)"},
      {"id": "rdl35", "order": 35, "code": "subtotal = subtotal + energy_charge"},
      {"id": "rdl36", "order": 36, "code": "///Fuel Charge"},
      {"id": "rdl37", "order": 37, "code": "// Step 3: Fuel Charge"},
      {"id": "rdl38", "order": 38, "code": "fuel_rate = GET_FACTOR(INPUT.RATE, \"FUEL_CHARGE\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl39", "order": 39, "code": "fuel_charge = INPUT.KWH * fuel_rate"},
      {"id": "rdl40", "order": 40, "code": "fuel_charge = ROUND(fuel_charge, 2)"},
      {"id": "rdl41", "order": 41, "code": "subtotal = subtotal + fuel_charge"},
      {"id": "rdl42", "order": 42, "code": "///Net Metering"},
      {"id": "rdl43", "order": 43, "code": "// Step 4: Net Metering Export Credit"},
      {"id": "rdl44", "order": 44, "code": "IF INPUT.NET_METERING == \"NEM\""},
      {"id": "rdl45", "order": 45, "code": "IF INPUT.KWH_GENERATED > 0"},
      {"id": "rdl46", "order": 46, "code": "nem_credit_rate = GET_FACTOR(INPUT.RATE, \"NEM_EXPORT_CREDIT\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl47", "order": 47, "code": "nem_export_credit = INPUT.KWH_GENERATED * nem_credit_rate"},
      {"id": "rdl48", "order": 48, "code": "// Use ABS to ensure credit is positive for display"},
      {"id": "rdl49", "order": 49, "code": "nem_export_credit = ABS(nem_export_credit)"},
      {"id": "rdl50", "order": 50, "code": "nem_export_credit = ROUND(nem_export_credit, 2)"},
      {"id": "rdl51", "order": 51, "code": "subtotal = subtotal - nem_export_credit"},
      {"id": "rdl52", "order": 52, "code": "ENDIF"},
      {"id": "rdl53", "order": 53, "code": "ENDIF"},
      {"id": "rdl54", "order": 54, "code": "///Demand Charge"},
      {"id": "rdl55", "order": 55, "code": "// Step 5: Demand charge with ratchet, power-factor adjustment, and cap"},
      {"id": "rdl56", "order": 56, "code": "demand_rate = GET_FACTOR(INPUT.RATE, \"DEMAND_CHARGE\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl57", "order": 57, "code": "demand_cap = GET_FACTOR(INPUT.RATE, \"DEMAND_CAP\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl57a", "order": 57.1, "code": "ratchet_pct = GET_FACTOR(INPUT.RATE, \"RATCHET_PCT\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl57b", "order": 57.2, "code": "target_pf = GET_FACTOR(INPUT.RATE, \"TARGET_POWER_FACTOR\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl57c", "order": 57.3, "code": "// Billing demand = greater of current peak or ratchet floor (no-op when no history)"},
      {"id": "rdl57d", "order": 57.4, "code": "billing_demand = CALCULATE_RATCHET(INPUT.KWD, INPUT.KWD_HISTORY, ratchet_pct)"},
      {"id": "rdl58", "order": 58, "code": "demand_charge = 0"},
      {"id": "rdl59", "order": 59, "code": "IF billing_demand > 0"},
      {"id": "rdl60", "order": 60, "code": "raw_demand_charge = billing_demand * demand_rate"},
      {"id": "rdl60a", "order": 60.1, "code": "// Power-factor adjustment (no-op when POWER_FACTOR is 0 or at/above target)"},
      {"id": "rdl60b", "order": 60.2, "code": "raw_demand_charge = POWER_FACTOR_ADJ(raw_demand_charge, INPUT.POWER_FACTOR, target_pf)"},
      {"id": "rdl61", "order": 61, "code": "// Cap demand charge using MIN function"},
      {"id": "rdl62", "order": 62, "code": "demand_charge = MIN(raw_demand_charge, demand_cap)"},
      {"id": "rdl63", "order": 63, "code": "demand_charge = ROUND(demand_charge, 2)"},
      {"id": "rdl64", "order": 64, "code": "subtotal = subtotal + demand_charge"},
      {"id": "rdl65", "order": 65, "code": "ENDIF"},
      {"id": "rdl65a", "order": 65.1, "code": "///Critical Peak Pricing"},
      {"id": "rdl65b", "order": 65.2, "code": "// CPP adder applies only on caller-declared event days (no-op when EVENT_DATES empty)"},
      {"id": "rdl65c", "order": 65.3, "code": "cpp_charge = 0"},
      {"id": "rdl65d", "order": 65.4, "code": "is_event_day = IS_EVENT_DAY(INPUT.BILL_DATE, INPUT.EVENT_DATES)"},
      {"id": "rdl65e", "order": 65.5, "code": "IF is_event_day > 0"},
      {"id": "rdl65f", "order": 65.6, "code": "cpp_adder = GET_FACTOR(INPUT.RATE, \"CPP_ADDER\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl65g", "order": 65.7, "code": "cpp_charge = billing_demand * cpp_adder"},
      {"id": "rdl65h", "order": 65.8, "code": "cpp_charge = ROUND(cpp_charge, 2)"},
      {"id": "rdl65i", "order": 65.9, "code": "subtotal = subtotal + cpp_charge"},
      {"id": "rdl65j", "order": 65.95, "code": "ENDIF"},
      {"id": "rdl65k", "order": 65.96, "code": "///Riders"},
      {"id": "rdl65l", "order": 65.97, "code": "// Per-kWh riders/surcharges applied by code (no-op when RIDERS is empty)"},
      {"id": "rdl65m", "order": 65.98, "code": "rider_total = 0"},
      {"id": "rdl65n", "order": 65.99, "code": "FOR rider IN INPUT.RIDERS"},
      {"id": "rdl65o", "order": 65.991, "code": "rider_rate = GET_FACTOR(\"RIDER\", rider, \"\", \"\", \"\", effective_date)"},
      {"id": "rdl65p", "order": 65.992, "code": "rider_total = rider_total + (INPUT.KWH * rider_rate)"},
      {"id": "rdl65q", "order": 65.993, "code": "ENDFOR"},
      {"id": "rdl65r", "order": 65.994, "code": "rider_total = ROUND(rider_total, 2)"},
      {"id": "rdl65s", "order": 65.995, "code": "subtotal = subtotal + rider_total"},
      {"id": "rdl66", "order": 66, "code": "///Franchise Fee"},
      {"id": "rdl67", "order": 67, "code": "// Step 6: Franchise Fee"},
      {"id": "rdl68", "order": 68, "code": "franchise_rate = GET_FACTOR(\"FRANCHISE\", INPUT.LOCALITY, \"\", \"\", \"\", effective_date)"},
      {"id": "rdl69", "order": 69, "code": "franchise_fee = subtotal * franchise_rate"},
      {"id": "rdl70", "order": 70, "code": "franchise_fee = ROUND(franchise_fee, 2)"},
      {"id": "rdl71", "order": 71, "code": "subtotal = subtotal + franchise_fee"},
      {"id": "rdl72", "order": 72, "code": "// Log subtotal for debugging using DEBUG_LOG"},
      {"id": "rdl73", "order": 73, "code": "subtotal = DEBUG_LOG(\"subtotal_before_tax\", subtotal)"},
      {"id": "rdl74", "order": 74, "code": "///Taxes"},
      {"id": "rdl75", "order": 75, "code": "// Step 7: Taxes"},
      {"id": "rdl76", "order": 76, "code": "sales_tax = 0"},
      {"id": "rdl77", "order": 77, "code": "gross_receipts_tax = 0"},
      {"id": "rdl78", "order": 78, "code": "total_tax = 0"},
      {"id": "rdl79", "order": 79, "code": "tax_exempt_classes = [\"GOVERNMENT\", \"NONPROFIT\", \"RELIGIOUS\"]"},
      {"id": "rdl80", "order": 80, "code": "IF INPUT.TAX_CLASS IN tax_exempt_classes"},
      {"id": "rdl81", "order": 81, "code": "total = subtotal"},
      {"id": "rdl82", "order": 82, "code": "ELSE"},
      {"id": "rdl83", "order": 83, "code": "sales_tax_rate = GET_FACTOR(\"STATE_SALES_TAX\", \"\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl84", "order": 84, "code": "sales_tax = subtotal * sales_tax_rate"},
      {"id": "rdl85", "order": 85, "code": "sales_tax = ROUND(sales_tax, 2)"},
      {"id": "rdl86", "order": 86, "code": "grt_rate = GET_FACTOR(\"GROSS_RECEIPTS_TAX\", \"\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl87", "order": 87, "code": "gross_receipts_tax = subtotal * grt_rate"},
      {"id": "rdl88", "order": 88, "code": "gross_receipts_tax = ROUND(gross_receipts_tax, 2)"},
      {"id": "rdl89", "order": 89, "code": "total_tax = sales_tax + gross_receipts_tax"},
      {"id": "rdl90", "order": 90, "code": "total = subtotal + total_tax"},
      {"id": "rdl91", "order": 91, "code": "ENDIF"},
      {"id": "rdl92", "order": 92, "code": "///Minimum Bill"},
      {"id": "rdl93", "order": 93, "code": "// Step 8: Enforce minimum bill using MAX"},
      {"id": "rdl94", "order": 94, "code": "minimum_bill = GET_FACTOR(INPUT.RATE, \"MINIMUM_BILL\", \"\", \"\", \"\", effective_date)"},
      {"id": "rdl95", "order": 95, "code": "total = MAX(total, minimum_bill)"},
      {"id": "rdl96", "order": 96, "code": "///Finalization"},
      {"id": "rdl97", "order": 97, "code": "// Step 9: Round and finalize"},
      {"id": "rdl98", "order": 98, "code": "total = ROUND_CENTS(total, \"HALF_UP\")"},
      {"id": "rdl99", "order": 99, "code": "///Output"},
      {"id": "rdl100", "order": 100, "code": "// Step 10: Add to output with categories"},
      {"id": "rdl101", "order": 101, "code": "OUTPUT.INSERT(\"Billing Period\", \"billing_month\", billing_month)"},
      {"id": "rdl102", "order": 102, "code": "OUTPUT.INSERT(\"Billing Period\", \"is_summer\", is_summer)"},
      {"id": "rdl103", "order": 103, "code": "OUTPUT.INSERT(\"Base Charges\", \"customer_charge\", customer_charge)"},
      {"id": "rdl104", "order": 104, "code": "OUTPUT.INSERT(\"Energy Charges\", \"energy_charge\", energy_charge)"},
      {"id": "rdl105", "order": 105, "code": "OUTPUT.INSERT(\"Energy Charges\", \"fuel_charge\", fuel_charge)"},
      {"id": "rdl106", "order": 106, "code": "OUTPUT.INSERT(\"Net Metering\", \"nem_export_credit\", nem_export_credit)"},
      {"id": "rdl107", "order": 107, "code": "OUTPUT.INSERT(\"Demand Charges\", \"demand_charge\", demand_charge)"},
      {"id": "rdl107a", "order": 107.1, "code": "OUTPUT.INSERT(\"Demand Charges\", \"billing_demand\", billing_demand)"},
      {"id": "rdl107b", "order": 107.2, "code": "OUTPUT.INSERT(\"Demand Charges\", \"cpp_charge\", cpp_charge)"},
      {"id": "rdl107c", "order": 107.3, "code": "OUTPUT.INSERT(\"Fees\", \"rider_total\", rider_total)"},
      {"id": "rdl108", "order": 108, "code": "OUTPUT.INSERT(\"Fees\", \"franchise_fee\", franchise_fee)"},
      {"id": "rdl109", "order": 109, "code": "OUTPUT.INSERT(\"Taxes\", \"sales_tax\", sales_tax)"},
      {"id": "rdl110", "order": 110, "code": "OUTPUT.INSERT(\"Taxes\", \"gross_receipts_tax\", gross_receipts_tax)"},
      {"id": "rdl111", "order": 111, "code": "OUTPUT.INSERT(\"Totals\", \"subtotal\", subtotal)"},
      {"id": "rdl112", "order": 112, "code": "OUTPUT.INSERT(\"Taxes\", \"total_tax\", total_tax)"},
      {"id": "rdl113", "order": 113, "code": "OUTPUT.INSERT(\"Totals\", \"total\", total)"}
    ],
    "createdBy": "admin",
    "updatedBy": "admin"
  }
]
