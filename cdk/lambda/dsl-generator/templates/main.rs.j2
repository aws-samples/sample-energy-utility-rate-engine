/// Override inputs - batch-level parameters that apply to all calculations
/// These are accessed in RDL via OVERRIDE.* (e.g., OVERRIDE.BILL_DATE)
#[derive(Debug, Clone, Deserialize, Default)]
#[serde(default)]
pub struct OverrideInput {
    #[serde(rename = "BILL_DATE")]
    pub bill_date: Option<String>,
    #[serde(rename = "BILL_DATE_OFFSET_YEARS")]
    pub bill_date_offset_years: Option<f64>,
    #[serde(rename = "BILL_DATE_OFFSET_MONTHS")]
    pub bill_date_offset_months: Option<f64>,
}

/// Request wrapper for inputs with optional overrides
#[derive(Debug, Deserialize)]
pub struct RequestWithOverrides {
    #[serde(default)]
    pub overrides: OverrideInput,
    pub inputs: Vec<Value>,
}

/// Output item with category grouping for structured bill display
#[derive(Debug, Clone, Serialize)]
pub struct OutputItem {
