}

#[derive(Debug, Serialize)]
pub struct CalculationResult {
    pub status: String,
    pub output: Vec<OutputItem>,
    #[serde(skip_serializing_if = "Vec::is_empty")]
    pub errors: Vec<String>,
    #[serde(skip_serializing_if = "HashMap::is_empty")]
    pub debug: HashMap<String, Value>,
    pub request: Value,
}

#[derive(Debug, Serialize)]
pub struct BatchResult {
    pub input: Value,
    pub result: CalculationResult,
}

#[derive(Debug, Serialize)]
pub struct BatchResponse {
    pub results: Vec<BatchResult>,
}

/// API Gateway Lambda Proxy response format
#[derive(Debug, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct ApiGatewayResponse {
    pub status_code: u16,
    pub headers: HashMap<String, String>,
    pub body: String,
}

impl ApiGatewayResponse {
    fn success(body: &str) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());
        headers.insert("Access-Control-Allow-Origin".to_string(), "*".to_string());
        headers.insert("Access-Control-Allow-Headers".to_string(), "Content-Type,Authorization".to_string());

        ApiGatewayResponse {
            status_code: 200,
            headers,
            body: body.to_string(),
        }
    }

    fn error(status_code: u16, message: &str) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());
        headers.insert("Access-Control-Allow-Origin".to_string(), "*".to_string());

        let body = serde_json::json!({ "error": message }).to_string();

        ApiGatewayResponse {
            status_code,
            headers,
            body,
        }
    }
}

/// S3 batch processing input - Lambda reads from S3 and writes results to S3
#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct S3BatchInput {
    pub s3_input: String,   // s3://bucket/path/input.jsonl
    pub s3_output: String,  // s3://bucket/path/output.jsonl
    #[serde(default)]
    pub overrides: OverrideInput,  // Optional overrides applied to all records
}

/// S3 batch processing result summary
#[derive(Debug, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct S3BatchSummary {
    pub status: String,
    pub records_processed: usize,
    pub records_succeeded: usize,
    pub records_failed: usize,
    pub s3_output: String,
}

/// Parse S3 URI into bucket and key
fn parse_s3_uri(uri: &str) -> Option<(String, String)> {
    if !uri.starts_with("s3://") {
        return None;
    }
    let path = &uri[5..];
    let slash_pos = path.find('/')?;
    let bucket = path[..slash_pos].to_string();
    let key = path[slash_pos + 1..].to_string();
    Some((bucket, key))
}

/// Process S3 batch - read JSONL from S3, process each line, write results to S3
async fn process_s3_batch(input: S3BatchInput) -> Result<S3BatchSummary, String> {
    let s3_client = S3_CLIENT.get().ok_or("S3 client not initialized")?;

    // Force fresh cache reload for batch processing
    // This ensures each batch job gets the latest factor data, critical for:
    // - Provisioned concurrency instances that may have stale cached data
    // - Long-running batch jobs where data may have been updated
    clear_factor_cache();

    // Parse input and output URIs
    let (input_bucket, input_key) = parse_s3_uri(&input.s3_input)
        .ok_or_else(|| format!("Invalid S3 input URI: {}", input.s3_input))?;
    let (output_bucket, output_key) = parse_s3_uri(&input.s3_output)
        .ok_or_else(|| format!("Invalid S3 output URI: {}", input.s3_output))?;

    tracing::info!("Processing S3 batch: {} -> {}", input.s3_input, input.s3_output);

    // Read input file from S3
    let get_result = s3_client
        .get_object()
        .bucket(&input_bucket)
        .key(&input_key)
        .send()
        .await
        .map_err(|e| format!("Failed to read from S3: {}", e))?;

    let body_bytes = get_result.body
        .collect()
        .await
        .map_err(|e| format!("Failed to read S3 body: {}", e))?
        .into_bytes();

    // Process each line as JSONL
    let reader = BufReader::new(body_bytes.as_ref());
    let mut output_lines: Vec<String> = Vec::new();
    let mut records_processed = 0;
    let mut records_succeeded = 0;
    let mut records_failed = 0;

    for line in reader.lines() {
        let line = line.map_err(|e| format!("Failed to read line: {}", e))?;
        let line = line.trim();
        if line.is_empty() {
            continue;
        }

        records_processed += 1;

        // Parse and process the input with overrides
        let result = match serde_json::from_str::<Value>(line) {
            Ok(input_value) => {
                let batch_result = process_single_input(input_value, &input.overrides);
                if batch_result.result.status == "success" {
                    records_succeeded += 1;
                } else {
                    records_failed += 1;
                }
                batch_result
            }
            Err(e) => {
                records_failed += 1;
                BatchResult {
                    input: Value::String(line.to_string()),
                    result: CalculationResult {
                        status: "error".to_string(),
                        output: Vec::new(),
                        errors: vec![format!("Failed to parse JSON: {}", e)],
                        debug: HashMap::new(),
                        request: Value::Null,
                    },
                }
            }
        };

        // Serialize result as JSONL line
        let result_json = serde_json::to_string(&result)
            .map_err(|e| format!("Failed to serialize result: {}", e))?;
        output_lines.push(result_json);
    }

    // Write output file to S3
    let output_body = output_lines.join("\n");
    s3_client
        .put_object()
        .bucket(&output_bucket)
        .key(&output_key)
        .body(ByteStream::from(output_body.into_bytes()))
        .content_type("application/x-ndjson")
        .send()
        .await
        .map_err(|e| format!("Failed to write to S3: {}", e))?;

    tracing::info!(
        "Batch complete: {} processed, {} succeeded, {} failed",
        records_processed, records_succeeded, records_failed
    );

    Ok(S3BatchSummary {
        status: if records_failed == 0 { "success".to_string() } else { "partial".to_string() },
        records_processed,
        records_succeeded,
        records_failed,
        s3_output: input.s3_output,
    })
}

