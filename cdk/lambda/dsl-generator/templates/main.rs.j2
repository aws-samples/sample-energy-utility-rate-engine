/// Clear the factor cache - used for forced reloads (e.g., S3 batch mode)
fn clear_factor_cache() {
    FACTOR_CACHE.with(|cache| {
        cache.borrow_mut().clear();
    });
    CACHE_LOADED.with(|loaded| {
        *loaded.borrow_mut() = false;
    });
    CACHE_TIMESTAMP.with(|ts| {
        *ts.borrow_mut() = None;
    });
    tracing::info!("Factor cache cleared for fresh reload");
}

/// Check if cache has expired based on TTL
fn is_cache_expired() -> bool {
    CACHE_TIMESTAMP.with(|ts| {
        if let Some(timestamp) = *ts.borrow() {
            timestamp.elapsed() > Duration::from_secs(CACHE_TTL_SECS)
        } else {
            false // No timestamp means not loaded yet
        }
    })
}

/// Load all factors for the scenario into cache
/// Uses TTL-based expiration - cache automatically refreshes after 5 minutes
fn load_factor_cache_once() {
    // Check if cache expired (TTL-based invalidation for provisioned concurrency)
    if is_cache_expired() {
        tracing::info!("Factor cache TTL expired ({}s), reloading...", CACHE_TTL_SECS);
        clear_factor_cache();
    }

    // Check if already loaded and not expired
    let already_loaded = CACHE_LOADED.with(|loaded| *loaded.borrow());
    if already_loaded {
        return;
    }

    let client = DB_CLIENT.get().expect("DynamoDB client not initialized");
    let table = FACTORS_TABLE_NAME.get().expect("Factors table name not initialized").clone();
    let scenario = SCENARIO.get().expect("Scenario not initialized");

    // Build HashMap grouped by lookup_key for O(1) lookups
    let mut factor_map: HashMap<String, Vec<FactorEntry>> = HashMap::new();

    // Use futures::executor to run async code from sync context
    let result = futures::executor::block_on(async {
        client
            .query()
            .table_name(&table)
            .key_condition_expression("scenario = :scenario")
            .expression_attribute_values(":scenario", aws_sdk_dynamodb::types::AttributeValue::S(scenario.to_string()))
            .send()
            .await
    });

    match result {
        Ok(output) => {
            if let Some(items) = output.items {
                for item in items {
                    // Extract factor_key (format: key1#key2#key3#key4#key5#start_date)
                    let factor_key = item.get("factor_key")
                        .and_then(|v| v.as_s().ok())
                        .map(|s| s.to_string());

                    let start_date = item.get("start_date")
                        .and_then(|v| v.as_s().ok())
                        .map(|s| s.to_string())
                        .unwrap_or_else(|| "0000-00-00".to_string());

                    let end_date = item.get("end_date")
                        .and_then(|v| v.as_s().ok())
                        .map(|s| s.to_string())
                        .unwrap_or_else(|| "9999-12-31".to_string());

                    let value = item.get("value")
                        .and_then(|v| v.as_n().ok())
                        .and_then(|n| n.parse::<f64>().ok())
                        .unwrap_or(0.0);

                    if let Some(factor_key_str) = factor_key {
                        // Factor key in DB: key1#key2#...#start_date
                        // Strip the trailing #start_date to get lookup key
                        let lookup_key = if let Some(last_hash) = factor_key_str.rfind('#') {
                            factor_key_str[..last_hash].to_string()
                        } else {
                            factor_key_str
                        };
                        // Group factors by lookup_key for O(1) access
                        factor_map
                            .entry(lookup_key)
                            .or_insert_with(Vec::new)
                            .push(FactorEntry {
                                start_date,
                                end_date,
                                value,
                            });
                    }
                }
            }
        }
        Err(e) => {
            tracing::warn!("Failed to load factors from Factors table: {}", e);
        }
    }

    // Store factor map in cache
    let factor_count: usize = factor_map.values().map(|v| v.len()).sum();
    FACTOR_CACHE.with(|cache| {
        *cache.borrow_mut() = factor_map;
    });

    // Mark as loaded and record timestamp for TTL tracking
    CACHE_LOADED.with(|loaded| {
        *loaded.borrow_mut() = true;
    });
    CACHE_TIMESTAMP.with(|ts| {
        *ts.borrow_mut() = Some(Instant::now());
    });

    tracing::info!("Loaded {} factors into cache for scenario {} (TTL: {}s)",
        factor_count,
        scenario,
        CACHE_TTL_SECS);
}

fn process_single_input(input_value: Value, overrides: &OverrideInput) -> BatchResult {
    let request_json = input_value.clone();

    // Parse input
    let input: CalculationInput = match serde_json::from_value(input_value.clone()) {
        Ok(input) => input,
        Err(e) => {
            return BatchResult {
                input: input_value,
                result: CalculationResult {
                    status: "error".to_string(),
                    output: Vec::new(),
                    errors: vec![format!("Failed to parse input: {}", e)],
                    debug: HashMap::new(),
                    request: request_json,
                },
            };
        }
    };

    // Clone overrides for the closure
    let overrides_clone = overrides.clone();

    // Run calculation and catch panics
    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        calculate_rate(&input, &overrides_clone, request_json.clone())
    }));

    match result {
        Ok(calc_result) => BatchResult {
            input: input_value,
            result: calc_result,
        },
        Err(e) => {
            let error_msg = if let Some(s) = e.downcast_ref::<&str>() {
                s.to_string()
            } else if let Some(s) = e.downcast_ref::<String>() {
                s.clone()
            } else {
                "Unknown panic occurred during calculation".to_string()
            };

            BatchResult {
                input: input_value,
                result: CalculationResult {
                    status: "error".to_string(),
                    output: Vec::new(),
                    errors: vec![error_msg],
                    debug: HashMap::new(),
                    request: request_json,
                },
            }
        }
    }
}

async fn function_handler(event: LambdaEvent<Value>) -> Result<Value, Error> {
    let (event_payload, _context) = event.into_parts();

    // Check for S3 batch mode first (direct invocation with s3Input/s3Output)
    if event_payload.get("s3Input").is_some() && event_payload.get("s3Output").is_some() {
        // S3 batch mode - read from S3, process, write to S3
        let s3_input: S3BatchInput = serde_json::from_value(event_payload)
            .map_err(|e| Error::from(format!("Invalid S3 batch input: {}", e)))?;

        match process_s3_batch(s3_input).await {
            Ok(summary) => {
                return Ok(serde_json::to_value(summary)?);
            }
            Err(e) => {
                let error_response = serde_json::json!({
                    "status": "error",
                    "error": e
                });
                return Ok(error_response);
            }
        }
    }

    // Check if this is an API Gateway event (has "body" field) or direct invocation
    let payload: Value = if let Some(body) = event_payload.get("body") {
        // API Gateway Lambda Proxy - body is a JSON string
        if let Some(body_str) = body.as_str() {
            match serde_json::from_str(body_str) {
                Ok(parsed) => parsed,
                Err(e) => {
                    let response = ApiGatewayResponse::error(400, &format!("Invalid JSON body: {}", e));
                    return Ok(serde_json::to_value(response)?);
                }
            }
        } else if body.is_null() {
            // Empty body
            let response = ApiGatewayResponse::error(400, "Request body is required");
            return Ok(serde_json::to_value(response)?);
        } else {
            // Body is already parsed (shouldn't happen with proxy integration)
            body.clone()
        }
    } else {
        // Direct Lambda invocation - payload is the input itself
        event_payload
    };

    // Check for request with overrides structure: { "overrides": {...}, "inputs": [...] }
    // Or support legacy formats: array of inputs or single input
    let (overrides, inputs): (OverrideInput, Vec<Value>) = if payload.get("inputs").is_some() {
        // New format with overrides
        match serde_json::from_value::<RequestWithOverrides>(payload.clone()) {
            Ok(req) => (req.overrides, req.inputs),
            Err(e) => {
                let response = ApiGatewayResponse::error(400, &format!("Invalid request format: {}", e));
                return Ok(serde_json::to_value(response)?);
            }
        }
    } else if payload.is_array() {
        // Legacy: Array of inputs without overrides
        (OverrideInput::default(), payload.as_array().unwrap().clone())
    } else {
        // Legacy: Single input without overrides
        (OverrideInput::default(), vec![payload])
    };

    // Process all inputs with the same overrides
    let results: Vec<BatchResult> = inputs.iter()
        .map(|input| process_single_input(input.clone(), &overrides))
        .collect();

    let response_body = BatchResponse { results };
    let body_json = serde_json::to_string(&response_body)?;

    // Return API Gateway response format
    let api_response = ApiGatewayResponse::success(&body_json);
    Ok(serde_json::to_value(api_response)?)
}

#[tokio::main]
async fn main() -> Result<(), Error> {
    tracing_subscriber::fmt()
        .with_max_level(tracing::Level::INFO)
        .with_target(false)
        .without_time()
        .init();

    // Initialize globals at cold start (no data loading - just client setup)
    let factors_table_name = env::var("FACTORS_TABLE").expect("FACTORS_TABLE environment variable not set");
    let scenario = env::var("SCENARIO").expect("SCENARIO environment variable not set");

    let config = aws_config::load_defaults(BehaviorVersion::latest()).await;
    let db_client = DynamoDbClient::new(&config);
    let s3_client = S3Client::new(&config);

    let _ = DB_CLIENT.set(db_client);
    let _ = S3_CLIENT.set(s3_client);
    let _ = FACTORS_TABLE_NAME.set(factors_table_name);
    let _ = SCENARIO.set(scenario.clone());

    tracing::info!("Initialized DynamoDB and S3 clients for scenario: {}", scenario);

    lambda_runtime::run(service_fn(function_handler)).await
}
