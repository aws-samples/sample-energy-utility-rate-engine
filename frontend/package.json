{
  "name": "rate-engine-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --skipLibCheck && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:rdl": "tsx ../tests/rdl-test.ts",
    "test:ui": "vitest run --passWithNoTests",
    "test": "npm run test:rdl && npm run test:ui"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.1",
