//
// then fill in the values from your deployed stack's CloudFormation outputs.
window.RATE_ENGINE_CONFIG = {
  API_ENDPOINT: "",
  REGION: "",
  USER_POOL_ID: "",
  USER_POOL_CLIENT_ID: ""
};
